; Derived from Microsoft's IndirectDisplay sample; see LICENSE.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Manufacturer%
CatalogFile=WindowDeckDisplay.cat
DriverVer=09/07/2026,0.1.0.8
PnpLockDown=1

[Manufacturer]
%Manufacturer%=WindowDeck,NTamd64.10.0...22000

[WindowDeck.NTamd64.10.0...22000]
%DeviceName%=Display_Install,WindowDeckDisplay

[SourceDisksFiles]
WindowDeckDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[Display_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Display_Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=DisplaySettings

[DisplaySettings]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"WindowDeckDisplayGroup"

[Display_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Display_Install.NT.Wdf]
UmdfService=WindowDeckDisplay,DriverService
UmdfServiceOrder=WindowDeckDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[DriverService]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\WindowDeckDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=13

[DriverCopy]
WindowDeckDisplay.dll

[Strings]
Manufacturer="WindowDeck"
DeviceName="WindowDeck Display"
DiskName="WindowDeck Display prototype"
